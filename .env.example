# ==============================================================================
# FRAME — Instagram Graph API Configuration for @io.tanmay
# ==============================================================================
# KEEP THIS FILE SECRET. DO NOT COMMIT .env TO VERSION CONTROL.
#
# Steps to obtain these values are documented in README-INSTAGRAM.md:
# 1. INSTAGRAM_ACCESS_TOKEN: Long-Lived Meta User Access Token (valid for 60 days).
# 2. INSTAGRAM_USER_ID: Your Instagram Creator/Business Account ID.
# ==============================================================================

# Meta Graph API Long-Lived Access Token
INSTAGRAM_ACCESS_TOKEN=

# Instagram Professional/Creator Account ID
INSTAGRAM_USER_ID=io.tanmay

# Server Port (default 3000)
PORT=3000

# Cache time-to-live in minutes (to stay safely within Meta rate limits)
CACHE_TTL_MINUTES=30
